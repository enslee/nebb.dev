<Window x:Class="Nebb.DevManager.ProcessShutdownDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="실행 중인 프로세스" Width="670" Height="430"
        MinWidth="530" MinHeight="330" WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Nebb를 닫은 뒤에도 프로세스를 유지할 수 있습니다. 종료할 항목을 선택하세요."
               TextWrapping="Wrap" Margin="0,0,0,10" />
    <ListBox x:Name="RunningList" Grid.Row="1" SelectionMode="Extended"
             DisplayMemberPath="Display" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button x:Name="KeepButton" Content="유지하고 닫기" Width="110" Click="Keep_Click" />
      <Button x:Name="StopSelectedButton" Content="선택 항목 종료 후 닫기" Width="155"
              Margin="8,0,0,0" Click="StopSelected_Click" />
      <Button x:Name="StopAllButton" Content="전체 종료 후 닫기" Width="130" Margin="8,0,0,0"
              Click="StopAll_Click" />
      <Button x:Name="CancelButton" Content="취소" Width="68" Margin="8,0,0,0" Click="Cancel_Click" />
    </StackPanel>
  </Grid>
</Window>
