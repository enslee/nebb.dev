<Window x:Class="Nebb.DevManager.PortConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixPeek 서버 포트 충돌" Width="560" SizeToContent="Height"
        MinHeight="220" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="7878 포트를 다른 PixPeek 서버가 사용 중입니다."
               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
    <TextBlock Grid.Row="1" x:Name="ProcessDetails" TextWrapping="Wrap"
               FontFamily="Consolas" Margin="0,0,0,12" />
    <TextBlock Grid.Row="2" Text="강제 종료하면 해당 서버를 사용 중인 다른 세션의 연결이 끊깁니다."
               TextWrapping="Wrap" Margin="0,0,0,20" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="취소" Width="90" Margin="0,0,8,0" IsCancel="True" />
      <Button Content="강제 종료 후 계속" Width="140" Click="Terminate_Click" />
    </StackPanel>
  </Grid>
</Window>
