<Window x:Class="Nebb.DevManager.GitCommitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git 커밋" Width="680" Height="450" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="90" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="SummaryText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,14" />
    <TextBlock Grid.Row="1" Text="커밋할 변경 파일" FontWeight="SemiBold" Margin="0,0,0,6" />
    <TextBox x:Name="ChangesText" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas"
             FontSize="12" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
             TextWrapping="NoWrap" />
    <TextBlock Grid.Row="3" Text="커밋 메시지" FontWeight="SemiBold" Margin="0,14,0,6" />
    <TextBox x:Name="MessageText" Grid.Row="4" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" />
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="취소" IsCancel="True" Width="90" Margin="0,0,8,0" />
      <Button x:Name="ConfirmButton" Content="커밋" Width="120" Click="Confirm_Click" />
    </StackPanel>
  </Grid>
</Window>
