<Window x:Class="Nebb.DevManager.CommandSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="실행·테스트 명령 설정" Width="930" Height="730" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="실행·테스트 명령 설정" FontSize="20" FontWeight="SemiBold" />
      <TextBlock x:Name="LocationText" TextWrapping="Wrap" Foreground="#65758B" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="설정" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox x:Name="ScopeChoice" Width="195" SelectionChanged="Choice_SelectionChanged">
        <ComboBoxItem Content="저장소 기본" />
        <ComboBoxItem Content="이 워크트리" />
      </ComboBox>
      <TextBlock Text="종류" VerticalAlignment="Center" Margin="20,0,8,0" />
      <ComboBox x:Name="KindChoice" Width="115" SelectionChanged="Choice_SelectionChanged">
        <ComboBoxItem Content="실행" />
        <ComboBoxItem Content="테스트" />
      </ComboBox>
      <Button x:Name="RefreshCandidatesButton" Content="후보 재탐지" Width="105"
              Margin="20,0,0,0" Click="RefreshCandidates_Click" />
    </StackPanel>

    <TextBlock x:Name="StateText" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,10" />

    <GroupBox Grid.Row="3" Header="탐지된 명령 후보">
      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox x:Name="CandidateList" DisplayMemberPath="Display"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button x:Name="ChooseCandidateButton" Content="선택한 후보 사용" Width="130"
                  Margin="0,0,8,0" Click="ChooseCandidate_Click" />
          <Button x:Name="ManualButton" Content="직접 추가" Width="90"
                  Click="Manual_Click" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="4" Header="선택한 명령 세부 설정" Margin="0,10,0,0">
      <Grid Margin="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="이름" Grid.Row="0" VerticalAlignment="Center" />
        <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" />
        <TextBlock Text="명령" Grid.Row="1" VerticalAlignment="Center" />
        <TextBox x:Name="CommandBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />
        <TextBlock Text="인수" Grid.Row="2" VerticalAlignment="Center" />
        <TextBox x:Name="ArgumentsBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" />
        <TextBlock Text="작업 폴더" Grid.Row="3" VerticalAlignment="Center" />
        <TextBox x:Name="WorkingDirectoryBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" />
        <TextBlock Text="환경변수" Grid.Row="4" VerticalAlignment="Top" Margin="0,4,0,0" />
        <TextBox x:Name="EnvironmentBox" Grid.Row="4" Grid.Column="1" Height="65"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 ToolTip="한 줄에 NAME=value 형식으로 입력하세요." />
      </Grid>
    </GroupBox>

    <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Button x:Name="CopyDefaultButton" Content="기본값 복사해 변경" Width="145"
                Margin="0,0,8,0" Click="CopyDefault_Click" />
        <Button x:Name="ClearButton" Content="선택 해제" Width="105"
                Click="Clear_Click" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="SaveButton" Content="저장" Width="90" Margin="0,0,8,0"
                Click="Save_Click" />
        <Button Content="취소" Width="90" Click="Cancel_Click" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
