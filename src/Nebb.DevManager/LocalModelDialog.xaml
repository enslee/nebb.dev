<Window x:Class="Nebb.DevManager.LocalModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="nebb 로컬 모델" Width="540" Height="430"
        MinWidth="500" MinHeight="400" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="nebb에서 사용할 모델 준비" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="RecommendationText" Grid.Row="1" Margin="0,12,0,12"
               TextWrapping="Wrap" />
    <StackPanel Grid.Row="2">
      <TextBlock Text="모델 선택" FontWeight="SemiBold" Margin="0,0,0,6" />
      <ComboBox x:Name="ModelChoice" DisplayMemberPath="DisplayName"
                SelectionChanged="ModelChoice_SelectionChanged" />
    </StackPanel>
    <TextBlock x:Name="ModelDetailsText" Grid.Row="3" Margin="0,12,0,0"
               TextWrapping="Wrap" />
    <TextBlock x:Name="SelectionText" Grid.Row="4" Margin="0,8,0,0"
               TextWrapping="Wrap" />
    <StackPanel Grid.Row="5" VerticalAlignment="Bottom" Margin="0,12,0,12">
      <ProgressBar x:Name="DownloadProgress" Height="16" Minimum="0" Maximum="100" />
      <TextBlock x:Name="ProgressText" Margin="0,5,0,0" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelInstallButton" Content="설치 취소" Width="90" Margin="0,0,8,0"
              Click="CancelInstall_Click" IsEnabled="False" />
      <Button x:Name="InstallButton" Content="설치하고 선택" Width="120" Margin="0,0,8,0"
              Click="Install_Click" />
      <Button Content="닫기" Width="80" Click="Close_Click" />
    </StackPanel>
  </Grid>
</Window>
